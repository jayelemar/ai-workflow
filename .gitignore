# Source-only nested repo: ignore everything by default.
*

# Repo metadata
!/.gitignore
!/README.md
!/AGENTS.md
# Allowlisted source directories
!/changelogs/
!/changelogs/shared/
!/changelogs/shared/**
!/docs/
!/docs/**
!/instructions/
!/instructions/shared/
!/instructions/shared/**
!/prompts/
!/prompts/**
!/scripts/
!/scripts/**
!/templates/
!/templates/**
!/wrappers/
!/wrappers/**

# Dynamic/local-only workflow data
/artifacts/
/logs/
/plans/
/specs/
/state/
