# Source-only nested repo: ignore everything by default.
*

# Repo metadata
!/.gitignore
!/README.md
!/AGENTS.md
!/v7/
!/v7/**

# Allowlisted source directories
!/changelogs/
!/changelogs/security.changelog.md
!/changelogs/testing.changelog.md
!/changelogs/workflow-state.changelog.md
!/changelogs/reasoning-quality.changelog.md
!/changelogs/debugging.changelog.md
!/docs/
!/docs/**
!/instructions/
!/instructions/shared/
!/instructions/shared/security.md
!/instructions/shared/testing.md
!/instructions/shared/workflow-state.md
!/instructions/shared/reasoning-quality.md
!/instructions/shared/debugging.md
!/instructions/shared/flow-trace-artifacts.md
!/prompts/
!/prompts/**
!/scripts/
!/scripts/**
!/templates/
!/templates/**
!/wrappers/
!/wrappers/**
!/changelogs/flow-trace-artifacts.changelog.md

# Dynamic/local-only workflow data
/artifacts/
/logs/
/plans/
/specs/
/state/
