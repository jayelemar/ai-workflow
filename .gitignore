# Source-only nested repository: ignore everything by default.
*

# Canonical source files
!/.gitignore
!/AGENTS.md
!/README.md
!/package.json
!/pnpm-lock.yaml
!/.agents/
!/.agents/skills/
!/.agents/skills/**
!/.codex/
!/.codex/config.toml
!/.github/
!/.github/**

# Canonical source directories
!/docs/
!/docs/**
!/instructions/
!/instructions/shared/
!/instructions/shared/**
!/prompts/
!/prompts/**
!/scripts/
!/scripts/**

# Project-local and generated workflow data
/instructions/index.md
/instructions/*.md
/artifacts/
/logs/
/plans/
/specs/
/state/
/tmp/
/node_modules/
