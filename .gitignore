# Source-only nested repository: ignore everything by default.
*

# Canonical source files
!/.gitignore
!/AGENTS.md
!/README.md
!/package.json
!/pnpm-lock.yaml

# Canonical source directories
!/config/
!/config/**
!/docs/
!/docs/**
!/instructions/
!/instructions/ai-workflow.md
!/instructions/shared/
!/instructions/shared/**
!/prompts/
!/prompts/**
!/scripts/
!/scripts/**
!/templates/
!/templates/**
!/wrappers/
!/wrappers/**

# Project-local and generated workflow data
/instructions/index.md
/instructions/*.md
!/instructions/ai-workflow.md
/artifacts/
/logs/
/plans/
/specs/
/state/
/tmp/
/node_modules/
